{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"customConditions": ["development"]
	},
	"include": [
		"src",
		"tests",
		"scripts",
		"playwright.config.ts",
		"vitest.config.ts"
	]
}
