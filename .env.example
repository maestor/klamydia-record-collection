# Local SQLite file URL. Migrations accept file: URLs only.
DATABASE_URL=file:.data/collection.db
PORT=3000
# Canonical public origin; defaults to http://localhost:<PORT>.
SITE_URL=http://localhost:3000
# For the optional read-only Instagram access check; keep real values in .env.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Private R2 bucket used for collection media.
R2_ENDPOINT=
R2_BUCKET=
# Importer-only read/write credentials; never configure these in a public runtime.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Separate object-read-only credentials for the web runtime.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
