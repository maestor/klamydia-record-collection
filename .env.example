# Local SQLite, or libsql://<database-host> for Turso.
DATABASE_URL=file:.data/collection.db
# Required for Turso. Use a read-only token for the web runtime;
# keep separate write tokens for GitHub migrations and manual Turso importing.
# Manual Turso commands load an ignored .env.turso-import copy of this file.
DATABASE_AUTH_TOKEN=
PORT=3000
# Canonical public origin; required on Vercel. Local default: http://localhost:<PORT>.
SITE_URL=http://localhost:3000
# Instagram access check and manual importer; keep real values in ignored env files.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Private R2 bucket used for collection media.
R2_ENDPOINT=
R2_BUCKET=
# Importer-only read/write credentials; never configure these in a public runtime.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Separate object-read-only credentials for the web runtime.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
