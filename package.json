{
	"name": "klamydia-record-collection",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "npm@11.19.1",
	"scripts": {
		"dev": "node --conditions=development --env-file-if-exists=.env --watch --import tsx src/server.ts",
		"db:migrate": "node --conditions=development --import tsx scripts/migrate.ts",
		"instagram:check": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/instagram-access.ts",
		"import:instagram": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/import-instagram.ts",
		"r2:restore": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/r2-restore.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src scripts tests package.json tsconfig.json tsconfig.build.json vitest.config.ts playwright.config.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"build": "tsc -p tsconfig.build.json",
		"build:gallery": "node --conditions=development --import tsx scripts/build-gallery.ts",
		"start": "node dist/server.js",
		"verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1160.0",
		"@aws-sdk/s3-request-presigner": "3.1160.0",
		"@hono/node-server": "2.1.5",
		"@libsql/client": "0.18.0",
		"hono": "4.13.14",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"htmx.org": "2.0.11",
		"jsdom": "30.1.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"imports": {
		"#routes/*": {
			"development": "./src/routes/*.js",
			"default": "./dist/routes/*.js"
		},
		"#repositories/*": {
			"development": "./src/repositories/*.js",
			"default": "./dist/repositories/*.js"
		},
		"#presentation/*": {
			"development": "./src/presentation/*.js",
			"default": "./dist/presentation/*.js"
		},
		"#views/*": {
			"development": "./src/views/*.js",
			"default": "./dist/views/*.js"
		},
		"#middleware/*": {
			"development": "./src/middleware/*.js",
			"default": "./dist/middleware/*.js"
		},
		"#i18n/*": {
			"development": "./src/i18n/*.js",
			"default": "./dist/i18n/*.js"
		}
	}
}
